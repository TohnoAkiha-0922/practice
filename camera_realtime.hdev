<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.0.0">
<procedure name="main">
<interface/>
<body>
<c>* ============================================================</c>
<c>* HALCON Real-time Camera Detection Demo</c>
<c>* Using DirectShow for USB webcams</c>
<c>* ============================================================</c>

<c>* Close all windows and turn off update for speed</c>
<l>dev_close_window ()</l>
<l>dev_update_off ()</l>

<c>* ---- STEP 1: Open camera ----</c>
<c>* Try DirectShow first (most common for USB cameras on Windows)</c>
<c>* If this fails, use the Image Acquisition Assistant to find your interface</c>
<l>try</l>
<l>    open_framegrabber ('DirectShow', 1, 1, 0, 0, 0, 0, 'default', 8, 'rgb', -1, 'false', 'default', '[0]', 0, -1, AcqHandle)</l>
<l>catch (Exception)</l>
<l>    * If DirectShow doesn't work, try default (first available interface)</l>
<l>    open_framegrabber ('File', 1, 1, 0, 0, 0, 0, 'default', 8, 'rgb', -1, 'false', 'default', 'default', 0, -1, AcqHandle)</l>
<l>    disp_message (WindowHandle, 'ERROR: No camera found! Using File interface.', 'window', 12, 12, 'red', 'true')</l>
<l>    stop ()</l>
<l>endtry</l>

<c>* Grab one frame to get image size for window</c>
<l>grab_image_start (AcqHandle, -1)</l>
<l>grab_image_async (Image, AcqHandle, -1)</l>
<l>get_image_size (Image, Width, Height)</l>

<c>* Open window sized to the camera image</c>
<l>dev_open_window (0, 0, Width/2, Height/2, 'black', WindowHandle)</l>
<l>dev_set_part (0, 0, Height - 1, Width - 1)</l>
<l>dev_set_draw ('margin')</l>
<l>dev_set_line_width (2)</l>

<c>* ---- STEP 2: Real-time processing loop ----</c>
<l>dev_display (Image)</l>
<l>disp_message (WindowHandle, 'Real-time camera mode. Press F5 to stop.', 'window', 12, 12, 'black', 'true')</l>

<l>FrameCount := 0</l>
<l>while (true)</l>
<c>    * Grab new frame</c>
<l>    grab_image_async (Image, AcqHandle, -1)</l>
<l>    FrameCount := FrameCount + 1</l>

<c>    * Convert to grayscale if color</c>
<l>    count_channels (Image, Channels)</l>
<l>    if (Channels == 3)</l>
<l>        rgb1_to_gray (Image, GrayImage)</l>
<l>    else</l>
<l>        GrayImage := Image</l>
<l>    endif</l>

<c>    * Binary threshold to find bright regions</c>
<l>    binary_threshold (GrayImage, BrightRegion, 'max_separability', 'light', UsedThreshold)</l>

<c>    * Connected component analysis - filter small noise</c>
<l>    connection (BrightRegion, ConnectedRegions)</l>
<l>    select_shape (ConnectedRegions, SelectedRegions, 'area', 'and', 200, 999999)</l>
<l>    area_center (SelectedRegions, Area, Row, Column)</l>
<l>    count_obj (SelectedRegions, Number)</l>

<c>    * Display results</c>
<l>    dev_display (Image)</l>
<l>    dev_set_color ('red')</l>
<l>    dev_display (SelectedRegions)</l>

<c>    * Overlay region info</c>
<l>    for i := 0 to |Area| - 1 by 1</l>
<l>        disp_message (WindowHandle, 'R' + (i+1)$'d' + ': ' + Area[i]$'5d' + 'px', 'image', Row[i], Column[i], 'black', 'true')</l>
<l>    endfor</l>

<l>    disp_message (WindowHandle, 'Frame: ' + FrameCount$'5d' + ' | Found ' + Number$'2d' + ' objects', 'window', 12, 12, 'cyan', 'true')</l>

<c>    * Check keyboard — press any key in HALCON window to stop</c>
<l>endwhile</l>

<c>* Cleanup</c>
<l>close_framegrabber (AcqHandle)</l>
<l>dev_close_window ()</l>

</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
